<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>wonder.frameworks</groupId>
        <artifactId>core</artifactId>
        <version>7.5-SNAPSHOT</version>
    </parent>

    <groupId>wonder.core</groupId>
    <artifactId>ERExtensions</artifactId>
    <name>ERExtensions Framework</name>
    <packaging>woframework</packaging>

    <build>
        <sourceDirectory>${basedir}/Sources</sourceDirectory>
        <testSourceDirectory>${basedir}/Tests/Sources</testSourceDirectory>
        <testResources>
            <testResource>
                <directory>${basedir}/Tests/Resources</directory>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.wocommunity</groupId>
                <artifactId>wolifecycle-maven-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <skipAppleProvidedFrameworks>true</skipAppleProvidedFrameworks>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <dependencies>
        <dependency>
            <groupId>wonder.core</groupId>
            <artifactId>JavaWOExtensions</artifactId>
        </dependency>
        <dependency>
            <groupId>wopatched</groupId>
            <artifactId>wonder-foundation</artifactId>
        </dependency>
        <dependency>
            <groupId>wopatched</groupId>
            <artifactId>wonder-eoaccess</artifactId>
        </dependency>
        <dependency>
            <groupId>wopatched</groupId>
            <artifactId>wonder-webobjects</artifactId>
        </dependency>
        <dependency>
            <groupId>wopatched</groupId>
            <artifactId>wonder-eocontrol</artifactId>
        </dependency>
        <dependency>
            <groupId>wopatched</groupId>
            <artifactId>wonder-jdbcadaptor</artifactId>
        </dependency>
        <dependency>
            <groupId>wopatched</groupId>
            <artifactId>wonder-wojspservlet</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ibm.icu</groupId>
            <artifactId>icu4j</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>joda-time</groupId>
            <artifactId>joda-time</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.httpcomponents</groupId>
            <artifactId>httpclient</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>
        <dependency>
			<groupId>commons-codec</groupId>
			<artifactId>commons-codec</artifactId>
		</dependency>
        <!-- er.testrunner is compiled into this framework, so JUnit stays on
             the compile classpath. Optional keeps it out of application runtime
             classpaths unless the application declares JUnit itself. -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>compile</scope>
            <optional>true</optional>
        </dependency>
        <!-- Servlet types used by ERXServletApplication. The container supplies
             the real API at runtime. JavaXML used to leak javax.servlet.* onto
             the classpath before it was dropped. -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>servlet-api</artifactId>
            <version>2.3</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
